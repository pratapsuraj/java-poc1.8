<?xml version="1.0"?>
<!-- Server-side config for the local HBase container.
     HBase advertises "host.docker.internal". That name resolves to 127.0.0.1 on the Windows host (Docker Desktop /
     Rancher Desktop add it to the hosts file) and to the host gateway inside other containers, so the IDE and the
     Spark containers can both reach the published ports. -->
<configuration>
  <property><name>hbase.cluster.distributed</name><value>true</value></property>
  <property><name>hbase.rootdir</name><value>/hbase-data</value></property>
  <property><name>hbase.zookeeper.quorum</name><value>localhost:2181</value></property>
  <property><name>hbase.master.hostname</name><value>host.docker.internal</value></property>
  <property><name>hbase.regionserver.hostname</name><value>host.docker.internal</value></property>
</configuration>
